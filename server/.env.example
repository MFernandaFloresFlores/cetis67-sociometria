# Configuración del servidor — copia este archivo como .env y ajusta los valores

# Puerto donde escucha la API + frontend compilado
PORT=3000

# CAMBIAR EN PRODUCCIÓN: secreto para firmar los JWT de sesión
JWT_SECRET=cambia-este-secreto-en-produccion

# Minutos de sesión con renovación deslizante
SESSION_MINUTES=60

# URL pública usada para generar los enlaces/QR de los cuestionarios
# (p. ej. https://sociometria.cetis67.edu.mx)
PUBLIC_URL=http://localhost:3000

# Ruta del archivo SQLite (por defecto server/data/cetis67.db)
# DB_PATH=./data/cetis67.db
